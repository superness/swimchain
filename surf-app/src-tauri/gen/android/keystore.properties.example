# Surf Android release signing — template.
#
# NEVER commit the real keystore.properties (it is gitignored — see
# `gen/android/.gitignore`). Copy this file to:
#
#     surf-app/src-tauri/gen/android/app/keystore.properties
#
# (next to `app/build.gradle.kts`, which reads it) and fill in real values.
# The same signing key must be used for every future release build — Android
# refuses updates signed with a different key, and there is no recovery if
# the keystore is lost. Store the real .jks/.keystore file and this filled-in
# properties file in the operator's vault, not on disk anywhere this repo's
# tooling can accidentally pick up or ship.
#
# CI note: build.gradle.kts falls back to these env vars if this file is
# absent: SURF_KEYSTORE_FILE, SURF_KEYSTORE_PASSWORD, SURF_KEY_ALIAS,
# SURF_KEY_PASSWORD. See surf-app/README.md, "Release signing (C4)".

storeFile=/absolute/path/to/surf-release.jks
storePassword=REPLACE_ME
keyAlias=surf
keyPassword=REPLACE_ME
