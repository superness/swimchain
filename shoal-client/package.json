  "description": "The Shoal — a sea you share with strangers, where safety is the crowd.",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc --noEmit -p tsconfig.json && tsc --noEmit -p tsconfig.ui.json && vite build",
