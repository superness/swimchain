    "app:dev": "tauri dev",
    "app:build": "tauri build",
    "icon": "tauri icon src-tauri/icons/source.svg --output src-tauri/icons",
    "smoke": "tsx scripts/regtest-smoke.ts",
    "smoke:two": "tsx scripts/two-client-smoke.ts",
    "smoke:checkpoint": "tsx scripts/two-client-checkpoint.ts",
    "drive:two": "tsx scripts/two-client-drive.ts",
    "harness": "tsx scripts/harness.ts",
    "test": "tsx scripts/run-tests.ts",
    "mint": "tsx scripts/mint-water.ts"
  },
  "dependencies": {
    "hash-wasm": "^4.12.0",
    "react": "^18.2.0",
    "react-dom": "^18.2.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2",
    "@types/jsdom": "^21.1.7",
    "@types/node": "^20.0.0",
    "@types/react": "^18.2.0",
    "@types/react-dom": "^18.2.0",
    "@vitejs/plugin-react": "^4.2.0",
    "esbuild": "^0.28.1",
    "jsdom": "^25.0.1",
    "tsx": "^4.23.1",
    "typescript": "^5.3.0",
    "vite": "^5.0.0"
